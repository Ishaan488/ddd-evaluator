# Copy to .env and fill in. This file is never committed.

# ---- Database -------------------------------------------------------------
# Postgres from docker-compose.yml (docker compose up -d db). Leave empty to run on an
# in-memory database that forgets everything when the server stops (fine for a demo).
DATABASE_URL=postgres://ddd:ddd@localhost:5432/ddd

# ---- Models ---------------------------------------------------------------
# Keys for the providers named in server/config/models.json. Only providers used by the
# roster need a key. Add any OpenAI-compatible provider in that file (OpenAI, OpenRouter, ...).
GROQ_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ---- Optional -------------------------------------------------------------
# PORT=4000
# DATA_DIR=./data                 uploaded workbooks are kept here
# MODELS_CONFIG=/path/to/models.json
# MOCK_LLM=1                      scripted models, no API calls (demo and tests)
# MOCK_DELAY_MS=700               pause per mock call so progress is visible
