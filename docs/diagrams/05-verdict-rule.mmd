flowchart TD
  S["Weighted score<br/>sum(weight x score) / sum(weights counted) x 100<br/>unscored dimensions count as 0<br/>human-only items count only once a person scores them"]
  Q1{"score below<br/>refine (75)?"}
  RED["RED<br/>the structure or understanding is wrong"]
  Q2{"score at or above<br/>accept (90)?"}
  Q3{"every critical<br/>dimension scored 4 or more?"}
  QH{"no HIGH-risk finding<br/>left open?"}
  Q4{"all human-only evidence<br/>supplied by a person?"}
  GRN["GREEN"]
  AMB["AMBER<br/>reasons listed: score, failed gates,<br/>high-risk findings, missing evidence"]
  OVR["A person may override up or down<br/>a written reason is required<br/>the agent's own verdict stays on record"]

  S --> Q1
  Q1 -- yes --> RED
  Q1 -- no --> Q2
  Q2 -- no --> AMB
  Q2 -- yes --> Q3
  Q3 -- no --> AMB
  Q3 -- yes --> QH
  QH -- no --> AMB
  QH -- yes --> Q4
  Q4 -- no --> AMB
  Q4 -- yes --> GRN
  RED -.-> OVR
  AMB -.-> OVR
  GRN -.-> OVR

  classDef good fill:#0f2218,stroke:#3ecf8e,color:#ececf0
  classDef warn fill:#262010,stroke:#f5b13d,color:#ececf0
  classDef bad fill:#2a1413,stroke:#f2655c,color:#ececf0
  classDef gate fill:#14141a,stroke:#7aa2f7,color:#ececf0
  classDef agent fill:#0f2a27,stroke:#2dd4bf,color:#ececf0
  class GRN good
  class AMB warn
  class RED bad
  class Q1,Q2,Q3,QH,Q4 gate
  class S,OVR agent
