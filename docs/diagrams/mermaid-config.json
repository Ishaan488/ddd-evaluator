{
  "theme": "base",
  "themeVariables": {
    "background": "#0a0a0c",
    "fontFamily": "Inter, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#14141a",
    "primaryTextColor": "#ececf0",
    "primaryBorderColor": "#34343d",
    "secondaryColor": "#101014",
    "tertiaryColor": "#0f0f12",
    "lineColor": "#6b6b78",
    "textColor": "#ececf0",
    "mainBkg": "#14141a",
    "nodeBorder": "#34343d",
    "clusterBkg": "#0e0e12",
    "clusterBorder": "#2a2a32",
    "titleColor": "#ececf0",
    "edgeLabelBackground": "#0a0a0c",
    "noteBkgColor": "#14141a",
    "noteTextColor": "#ececf0",
    "noteBorderColor": "#34343d",
    "actorBkg": "#14141a",
    "actorBorder": "#34343d",
    "actorTextColor": "#ececf0",
    "actorLineColor": "#3a3a44",
    "signalColor": "#9a9aa6",
    "signalTextColor": "#ececf0",
    "labelBoxBkgColor": "#14141a",
    "labelBoxBorderColor": "#34343d",
    "labelTextColor": "#ececf0",
    "loopTextColor": "#b4b4be",
    "activationBkgColor": "#10302c",
    "activationBorderColor": "#2dd4bf",
    "sequenceNumberColor": "#04201c",
    "attributeBackgroundColorOdd": "#101014",
    "attributeBackgroundColorEven": "#14141a"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "padding": 14,
    "nodeSpacing": 36,
    "rankSpacing": 46,
    "wrappingWidth": 430
  },
  "sequence": {
    "mirrorActors": false,
    "messageMargin": 40,
    "boxMargin": 8,
    "actorMargin": 40,
    "wrap": true,
    "width": 160,
    "noteMargin": 10
  },
  "themeCSS": ".row-rect-odd path, .row-rect-odd rect {fill:#101014 !important; stroke:#2a2a32 !important;} .row-rect-even path, .row-rect-even rect {fill:#16161c !important; stroke:#2a2a32 !important;} .attributeBoxOdd, .attributeBoxEven {stroke:#2a2a32 !important;} .attributeBoxOdd {fill:#101014 !important;} .attributeBoxEven {fill:#16161c !important;} .label.attribute-type, .label.attribute-name, .label.attribute-keys, .label.attribute-comment, .label.attribute-type span, .label.attribute-name span {color:#ececf0 !important; fill:#ececf0 !important;} .label.attribute-keys span, .label.attribute-comment span {color:#9a9aa6 !important;}"
}